      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  let content = item.json.content;\n\n  try {\n    content = content\n      .replace(/```json/g, '')\n      .replace(/```/g, '')\n      .trim();\n\n    // If the AI forgot the final closing brace, add it\n    if (!content.endsWith('}')) {\n      content += '}';\n    }\n\n    const data = JSON.parse(content);\n\n    output.push({\n      json: data\n    });\n\n  } catch (error) {\n    output.push({\n      json: {\n        parse_error: true,\n        original_content: content,\n        error: error.message\n      }\n    });\n  }\n}\n\nreturn output;"
      },
